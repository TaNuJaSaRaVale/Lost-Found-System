rules_version = '2';

// Security model
// - Anyone signed in can browse lost/found reports.
// - Users can only edit their own profile fields; role/status/warnings are admin-only.
// - Admins cannot change their own role or status (prevents accidental lock-out).
// - Suspended ("blocked") users cannot post, claim, chat or report.
// - Claims follow a strict state machine (see lost-found-app/services/claims.ts).
// - Chat messages are only visible to the two participants and only while the claim is open.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function myProfileExists() { return exists(docPath('users', uid())); }
    function isAdmin() {
      return signedIn() && myProfileExists() && get(docPath('users', uid())).data.role == 'admin';
    }
    function isActive() {
      return signedIn() && myProfileExists() && get(docPath('users', uid())).data.get('status', 'active') != 'blocked';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, minLen, maxLen) { return v is string && v.size() >= minLen && v.size() <= maxLen; }
    function optStr(d, field, maxLen) { return !(field in d) || (d[field] is string && d[field].size() <= maxLen); }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());

      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && str(request.resource.data.name, 1, 60)
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'studentClass', 'prn', 'phone', 'role', 'status', 'createdAt',
             'expoPushToken', 'notificationsEnabled']);

      allow update: if signedIn() && (
        // Self-service fields only
        (uid() == userId
          && changed().hasOnly(['name', 'studentClass', 'phone', 'prn', 'expoPushToken',
                                'notificationsEnabled', 'hasPendingWarning', 'updatedAt'])
          && (!('hasPendingWarning' in changed()) || request.resource.data.hasPendingWarning == false)
          && optStr(request.resource.data, 'name', 60))
        // Moderation by another admin
        || (isAdmin() && uid() != userId
          && changed().hasOnly(['role', 'status', 'warnings', 'hasPendingWarning'])
          && request.resource.data.get('role', 'user') in ['user', 'admin']
          && request.resource.data.get('status', 'active') in ['active', 'blocked'])
      );

      allow delete: if signedIn() && uid() == userId;
    }

    // ---------- lost & found reports ----------
    function validItem(d) {
      return str(d.title, 1, 80)
        && d.get('description', '') is string && d.get('description', '').size() <= 600
        && str(d.category, 1, 40)
        && str(d.location, 1, 80)
        && optStr(d, 'reward', 40)
        && optStr(d, 'currentlyAt', 80)
        && optStr(d, 'thumbnail', 60000);
    }

    // The other party of an approved claim may sync the status of this report (and nothing else).
    function statusSyncAllowed(col, itemId) {
      let claim = get(docPath('claims', request.resource.data.statusClaimId)).data;
      return changed().hasOnly(['status', 'statusClaimId', 'updatedAt'])
        && request.resource.data.status in ['open', 'pending_handover', 'returned']
        && claim.sourceItemId == itemId
        && claim.sourceItemType == col
        && uid() in [claim.ownerId, claim.claimantId];
    }

    function canCreateItem() {
      return isActive()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'open'
        && validItem(request.resource.data);
    }

    function canUpdateItem(col, itemId) {
      return signedIn() && (
        (resource.data.userId == uid() && request.resource.data.userId == uid() && validItem(request.resource.data))
        || isAdmin()
        || statusSyncAllowed(col, itemId)
      );
    }

    function canDeleteItem() {
      return signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    match /lost_items/{itemId} {
      allow read: if signedIn();
      allow create: if canCreateItem();
      allow update: if canUpdateItem('lost_items', itemId);
      allow delete: if canDeleteItem();
    }

    match /found_items/{itemId} {
      allow read: if signedIn();
      allow create: if canCreateItem();
      allow update: if canUpdateItem('found_items', itemId);
      allow delete: if canDeleteItem();
    }

    // Full-size photos, kept out of the item docs so feeds stay light.
    match /item_images/{itemId} {
      allow read: if signedIn();
      allow create: if isActive()
        && request.resource.data.userId == uid()
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000;
      allow delete: if signedIn() && (resource == null || resource.data.userId == uid() || isAdmin());
    }

    // ---------- claims ----------
    match /claims/{claimId} {
      function isParty() { return uid() == resource.data.claimantId || uid() == resource.data.ownerId; }

      allow read: if signedIn() && (isParty() || isAdmin());

      allow create: if isActive()
        && claimId == request.resource.data.itemId + '_' + uid()        // one claim per person per item
        && request.resource.data.claimantId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.itemType in ['lost_items', 'found_items']
        && request.resource.data.ownerId == get(docPath(request.resource.data.itemType, request.resource.data.itemId)).data.userId
        && request.resource.data.ownerId != uid()
        && str(request.resource.data.proofDescription, 1, 600)
        && (request.resource.data.sourceItemId == null
            || (request.resource.data.sourceItemType in ['lost_items', 'found_items']
                && get(docPath(request.resource.data.sourceItemType, request.resource.data.sourceItemId)).data.userId == uid()));

      allow update: if signedIn() && (
        // Chat bookkeeping by either party
        (isParty() && changed().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'hasUnread']))
        // Decisions by the reporter
        || (uid() == resource.data.ownerId && changed().hasOnly(['status', 'updatedAt'])
            && ((resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
             || (resource.data.status == 'approved' && request.resource.data.status in ['returned', 'rejected'])))
        // Claimant withdraws, or re-submits after withdrawing
        || (uid() == resource.data.claimantId
            && ((resource.data.status == 'pending' && request.resource.data.status == 'withdrawn'
                   && changed().hasOnly(['status', 'updatedAt']))
             || (resource.data.status == 'withdrawn' && request.resource.data.status == 'pending'
                   && changed().hasOnly(['status', 'proofDescription', 'updatedAt'])
                   && str(request.resource.data.proofDescription, 1, 600))))
      );

      allow delete: if signedIn() && (isParty() || isAdmin());
    }

    // ---------- chat ----------
    match /messages/{messageId} {
      function msg() { return request.resource.data; }

      function claimChatOpen() {
        let c = get(docPath('claims', msg().claimId)).data;
        return c.status in ['pending', 'approved', 'returned']
          && msg().participants[0] == c.claimantId
          && msg().participants[1] == c.ownerId;
      }

      function adminChat() {
        return msg().claimId.matches('admin_.*') && isAdmin()
          && msg().claimId == 'admin_' + msg().participants[0] + '_' + msg().participants[1];
      }

      allow read: if signedIn() && uid() in resource.data.participants;

      allow create: if isActive()
        && msg().senderId == uid()
        && msg().participants is list && msg().participants.size() == 2
        && uid() in msg().participants
        && str(msg().text, 1, 1000)
        && (adminChat() || claimChatOpen());
    }

    // ---------- moderation ----------
    match /user_reports/{reportId} {
      allow create: if isActive()
        && request.resource.data.reportedBy == uid()
        && request.resource.data.reportedUserId != uid()
        && str(request.resource.data.reason, 1, 300);
      allow read, delete: if isAdmin();
    }

    // Written only by Cloud Functions (Admin SDK bypasses these rules).
    // Expo push tokens, readable by signed-in users so the app can notify someone directly
    // (free Spark plan, no Cloud Functions). Only the owner can set or remove their own token.
    match /push_tokens/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && str(request.resource.data.token, 10, 200);
      allow delete: if signedIn() && uid() == userId;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
